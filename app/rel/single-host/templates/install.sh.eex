set -euo pipefail

if [ -e operately.env ]; then
  echo "operately.env already exists. Edit the existing configuration or use ./operately update to upgrade."
  echo "To resume a failed setup, follow the recovery steps in the single-host installation guide."
  exit 1
fi

BLUE="\033[0;34m"
LBLUE="\033[1;34m"
CLEAR="\033[0m"

echo -e "                                                                                        "
echo -e "${BLUE}       =${LBLUE}=======${BLUE}=        ${CLEAR}                                  "
echo -e "${BLUE}     ===${LBLUE}  =====${BLUE}====     ${CLEAR}                                  "
echo -e "${BLUE}   =====${LBLUE}     ==${BLUE}=====    ${CLEAR}    Operately <%= version %>      "
echo -e "${BLUE} =======${LBLUE}      =${BLUE}=======  ${CLEAR}    Single-Host Installation      "
echo -e "${BLUE}========${LBLUE}       ${BLUE}=======  ${CLEAR}                                  "
echo -e "${BLUE} =======${LBLUE}=      ${BLUE}======   ${CLEAR}    OS: $(uname -o)               "
echo -e "${BLUE}   =====${LBLUE}==     ${BLUE}====     ${CLEAR}    Architecture: $(uname -m)     "
echo -e "${BLUE}     ===${LBLUE}====   ${BLUE}===      ${CLEAR}                                  "
echo -e "${BLUE}       =${LBLUE}=======${BLUE}=        ${CLEAR}                                  "
echo -e "                                                                                        "

echo -e "Please answer the following questions before installation:"

echo -e ""
echo -e "1. What domain will you be using to run Operately? ${LBLUE}e.g. operately.example.com${CLEAR}"
read -p "   Domain: " DOMAIN

echo -e ""
echo -e "2. Do you want Operately to issue and auto-renew a Let's Encrypt SSL certificate?"
read -p "   Manage SSL certs? (y/n): " MANAGE_CERTS_YN

case $MANAGE_CERTS_YN in
        y|yes|Y)
                read -r -p "   Administrator email for Let's Encrypt: " ADMIN_EMAIL
                OPERATELY_URL_SCHEME="https"
                OPERATELY_URL_PORT="443"
                ;;
        *)
                read -r -p "   Public URL scheme (http/https) [http]: " OPERATELY_URL_SCHEME
                OPERATELY_URL_SCHEME=${OPERATELY_URL_SCHEME:-http}
                case $OPERATELY_URL_SCHEME in
                        http) DEFAULT_URL_PORT=80 ;;
                        https) DEFAULT_URL_PORT=443 ;;
                        *) echo "OPERATELY_URL_SCHEME must be http or https"; exit 1 ;;
                esac

                read -r -p "   Public URL port [${DEFAULT_URL_PORT}]: " OPERATELY_URL_PORT
                OPERATELY_URL_PORT=${OPERATELY_URL_PORT:-$DEFAULT_URL_PORT}
                if ! [[ "$OPERATELY_URL_PORT" =~ ^[0-9]{1,5}$ ]] ||
                   (( 10#$OPERATELY_URL_PORT < 1 || 10#$OPERATELY_URL_PORT > 65535 )); then
                        echo "OPERATELY_URL_PORT must be an integer between 1 and 65535"
                        exit 1
                fi
                OPERATELY_URL_PORT=$((10#$OPERATELY_URL_PORT))
                ;;
esac

PUBLIC_URL="${OPERATELY_URL_SCHEME}://${DOMAIN}"
if [[ "$OPERATELY_URL_SCHEME:$OPERATELY_URL_PORT" != "http:80" &&
      "$OPERATELY_URL_SCHEME:$OPERATELY_URL_PORT" != "https:443" ]]; then
        PUBLIC_URL="${PUBLIC_URL}:${OPERATELY_URL_PORT}"
fi

echo -e ""
echo -e "Please verify the following:"
echo -e ""
echo -e "- Operately will be accessible from: ${LBLUE}${PUBLIC_URL}${CLEAR}"
case $MANAGE_CERTS_YN in
        y|yes|Y)
                echo -e "- Operately will issue and auto-renew SSL certificates from Let's Encrypt."
                echo -e "- Let's Encrypt will send emails to ${ADMIN_EMAIL}"
                ;;
        *)
                if [ "$OPERATELY_URL_SCHEME" = "https" ]; then
                        echo "- Configure your reverse proxy to terminate HTTPS and forward requests to Operately over HTTP."
                fi
                ;;
esac

echo -e "- The installation script will pull the Docker images for running Operately"
echo -e "- A PostgreSQL database will be created for Operately as a Docker container"
echo -e ""
read -p "Run the installation? (y/n) " YN

case $YN in
        y|yes|Y) echo "Starting the installation..." && sleep 3 ;;
        *)       echo "Stopping the installtion" && exit 1      ;;
esac

# Questions finished - Starting with writting configuration --------------------------

OPERATELY_HOST=${DOMAIN}
case $MANAGE_CERTS_YN in
        y|yes|Y)
                CERT_DOMAIN=${DOMAIN}
                CERT_AUTO_RENEW="yes"
                CERT_EMAILS=$ADMIN_EMAIL
                ;;
        *)
                CERT_DOMAIN=""
                CERT_AUTO_RENEW="no"
                CERT_EMAILS=""
                ;;
esac
OPERATELY_BLOB_TOKEN_SECRET_KEY=$(openssl rand -base64 32)
SECRET_KEY_BASE=$(openssl rand -hex 32)
SYSTEM_SETTINGS_ENCRYPTION_KEYS=$(openssl rand -hex 32)
OPERATELY_INSTALLATION_ID=$(openssl rand -hex 16)

DB_USERNAME="operately"
POSTGRES_USER="operately"
POSTGRES_PASSWORD=$(openssl rand -hex 32)
DATABASE_URL="ecto://${DB_USERNAME}:${POSTGRES_PASSWORD}@db/operately"
ALLOW_LOGIN_WITH_EMAIL="yes"
ALLOW_SIGNUP_WITH_EMAIL="yes"
OPERATELY_BEACON_ENABLED="true"

CONFIG_TEMP=$(mktemp ./operately.env.XXXXXX)
trap 'rm -f "$CONFIG_TEMP"' EXIT

{
  echo "OPERATELY_HOST=\"${DOMAIN}\""
  echo "OPERATELY_BLOB_TOKEN_SECRET_KEY=\"${OPERATELY_BLOB_TOKEN_SECRET_KEY}\""
  echo "OPERATELY_INSTALLATION_ID=\"${OPERATELY_INSTALLATION_ID}\""
  echo "CERT_DOMAIN=\"${CERT_DOMAIN}\""
  echo "CERT_AUTO_RENEW=\"${CERT_AUTO_RENEW}\""
  echo "CERT_EMAILS=\"${CERT_EMAILS}\""
  echo "OPERATELY_URL_PORT=\"${OPERATELY_URL_PORT}\""
  echo "OPERATELY_URL_SCHEME=\"${OPERATELY_URL_SCHEME}\""
  echo "SECRET_KEY_BASE=\"${SECRET_KEY_BASE}\""
  echo "SYSTEM_SETTINGS_ENCRYPTION_KEYS=\"${SYSTEM_SETTINGS_ENCRYPTION_KEYS}\""

  echo "DB_USERNAME=\"${DB_USERNAME}\""
  echo "POSTGRES_USER=\"${POSTGRES_USER}\""
  echo "POSTGRES_PASSWORD=\"${POSTGRES_PASSWORD}\""
  echo "DATABASE_URL=\"${DATABASE_URL}\""
  echo "ALLOW_LOGIN_WITH_EMAIL=\"${ALLOW_LOGIN_WITH_EMAIL}\""
  echo "ALLOW_SIGNUP_WITH_EMAIL=\"${ALLOW_SIGNUP_WITH_EMAIL}\""
  echo "OPERATELY_BEACON_ENABLED=\"${OPERATELY_BEACON_ENABLED}\""
} > "$CONFIG_TEMP"
mv "$CONFIG_TEMP" operately.env

if [ "$CERT_AUTO_RENEW" = "no" ]; then
  sed -i '/443:4001/d' docker-compose.yml
  if [ "$OPERATELY_URL_SCHEME" = "http" ]; then
    sed -i "s/80:4000/${OPERATELY_URL_PORT}:4000/" docker-compose.yml
  fi
fi

# Pulling and building docker images --------------------------------------------------

docker compose build

docker compose run --rm --user root app sh -c "chown -R nobody:root /certs"
docker compose run --rm --user root app sh -c "chown -R nobody:root /media"
docker compose run --rm --user root app chmod u=rwx /media

docker compose run --rm app sh -c "/opt/operately/bin/create_db"
docker compose run --rm app sh -c "/opt/operately/bin/migrate"

echo ""
echo "Operately is ready to be started! Run:"
echo ""
echo "  docker compose up --wait --detach"
echo ""
