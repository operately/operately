{
  "$schema": "https://unpkg.com/knip@2/schema.json",
  "entry": ["assets/js/app.tsx", "assets/build.js", "assets/codegen.ts", "vite.config.mjs"],
  "project": [
    "assets/js/**/*.ts",
    "assets/js/**/*.tsx",
    "assets/js/i18n.js",
    "ee/assets/js/**/*.ts",
    "ee/assets/js/**/*.tsx"
  ],
  "vite": { "config": [] },
  "ignore": [
    "assets/js/api/index.tsx",
    "ee/assets/js/admin_api/index.tsx",
    "**/__tests__/**",
    "assets/js/models/companies/hasFeature.tsx",
    "assets/js/routes/redirectUtils.tsx"
  ],
  "ignoreDependencies": ["turboui"],

  "rules": {
    "nsTypes": "off"
  }
}
