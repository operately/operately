<%= title(gettext("%{author} closed the %{goal_name} goal", author: short_name(@author), goal_name: @goal.name)) %>

<%= spacer() %>

<%= row do %>
  <%= if @success == "yes" do %>
    <%= gettext("Marked as accomplished") %>
  <% else %>
    <%= gettext("Marked as not accomplished") %>
  <% end %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= rich_text(@message) %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= cta_button(@link, @cta_text) %>
<% end %>
