<%= title(gettext("Your email address has changed")) %>
<%= spacer() %>
<%= row do %>
  <%= email_with_emphasis(gettext("Your Operately account email is now <email/>."), @new_email) %>
  <%= gettext("This change applies to all your companies. Your existing sessions remain signed in.") %>
<% end %>
<%= spacer() %>
<%= row do %>
  <%= gettext("If you didn’t make this change, contact your organization administrator for help.") %>
<% end %>
