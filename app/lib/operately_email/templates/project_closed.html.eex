<%= title(gettext("%{author} closed the %{project_name} project and submitted a retrospective", author: short_name(@author), project_name: @project.name)) %>

<%= spacer() %>
<%= title(gettext("Retrospective notes:"), font_size: 20) %>

<%= row do %>
  <%= rich_text(@retrospective.content) %>
<% end %>

<%= spacer() %>
<%= spacer() %>

<%= row do %>
  <%= cta_button(@link, @cta_text) %>
<% end %>
