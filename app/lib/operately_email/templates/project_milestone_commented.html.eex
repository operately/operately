<%= title(OperatelyEmail.Emails.ProjectMilestoneCommentedEmail.heading(@author, @milestone, @comment_action)) %>

<%= spacer() %>

<%= if @content not in [nil, %{}] do %>
  <%= row do %>
      <%= rich_text(@content) %>
  <% end %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= cta_button(@link, OperatelyEmail.Emails.ProjectMilestoneCommentedEmail.button_text(@comment_action)) %>
<% end %>
