<%= if @mentioned do %>
  <%= title(gettext("%{author} mentioned you in the description for \"%{task_name}\"", author: short_name(@author), task_name: @task_name)) %>
<% else %>
  <%= title(gettext("%{author} updated the description for \"%{task_name}\"", author: short_name(@author), task_name: @task_name)) %>
<% end %>

<%= spacer() %>

<%= if @description do %>
  <%= row do %>
    <%= rich_text(@description) %>
  <% end %>
<% else %>
  <%= row do %>
    <%= gettext("The description was cleared.") %>
  <% end %>
<% end %>

<%= spacer() %>

<%= row do %>
  <%= cta_button(@cta_url, gettext("View Task")) %>
<% end %>
