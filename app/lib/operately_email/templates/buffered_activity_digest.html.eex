<%= title(@subject) %>

<%= if Enum.empty?(@parent_groups) do %>
  <%= spacer() %>
  <%= digest_empty_state(@empty_title, @empty_body) %>
<% else %>
  <%= for group <- @parent_groups do %>
    <%= digest_group(group) %>
  <% end %>
<% end %>

<%= spacer() %>
<%= line() %>
<%= spacer() %>

<%= row do %>
  <div style="font-family: sans-serif; font-size: 12px; color: #94a3b8; text-align: center;">
    <%= link(@settings_url, @settings_label) %>
  </div>
<% end %>
