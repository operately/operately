{
  "name": "@operately/operately-cli",
  "version": "1.9.0",
  "description": "Official CLI for Operately external API",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "bin": {
    "operately": "dist/index.js",
    "op": "dist/index.js"
  },
  "files": [
    "dist/**",
    "docs/**"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && mkdir -p testreports && node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=testreports/junit.xml dist/test/*.test.js dist/test/**/*.test.js",
    "gen:catalog": "echo \"Catalog is generated by 'make gen.api.catalog'\"",
    "gen:commands": "node scripts/gen-commands-doc.mjs",
    "check:catalog": "node scripts/check-catalog-sync.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "axios": "^1.7.3",
    "jsdom": "^23.0.1",
    "marked": "^11.1.1",
    "open": "^10.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/node": "^22.10.2",
    "typescript": "^5.4.3"
  }
}
